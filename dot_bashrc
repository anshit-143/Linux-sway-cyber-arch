#
# ~/.bashrc
#

# If not running interactively, don't do anything
[[ $- != *i* ]] && return

alias ls='ls --color=auto'
alias grep='grep --color=auto'
PS1='[\u@\h \W]\$ '
fastfetch

# >>> conda initialize >>>
# !! Contents within this block are managed by 'conda init' !!
__conda_setup="$('/home/negan/anaconda3/bin/conda' 'shell.bash' 'hook' 2> /dev/null)"
if [ $? -eq 0 ]; then
    eval "$__conda_setup"
else
    if [ -f "/home/negan/anaconda3/etc/profile.d/conda.sh" ]; then
        . "/home/negan/anaconda3/etc/profile.d/conda.sh"
    else
        export PATH="/home/negan/anaconda3/bin:$PATH"
    fi
fi
unset __conda_setup
# <<< conda initialize <<<

export NEWT_COLORS='
root=,black
border=red,black
window=,black
shadow=,black
title=red,black
button=black,red
actbutton=black,cyan
checkbox=cyan,black
actcheckbox=black,cyan
entry=cyan,black
label=cyan,black
listbox=cyan,black
actlistbox=black,cyan
textbox=cyan,black
acttextbox=black,cyan
helpline=,black
roottext=cyan,black
emptyscale=,black
fullscale=,black
disentry=black,black
compactbutton=cyan,black
actsellistbox=black,cyan
sellistbox=cyan,black
'
